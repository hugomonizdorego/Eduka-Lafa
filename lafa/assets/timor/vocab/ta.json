  "w5410": "ஏதோ",
  "w5411": "ஒவ்வொருவரும்; ஒவ்வொன்றும்",
  "w5412": "அனைவரும்; எல்லாம்",
  "w5413": "மற்ற; வேறு",
  "w5414": "மற்றும்",
  "w5415": "அல்லது",
  "w5416": "ஆனால்",
  "w5417": "ஏனென்றால்",
  "w5418": "எந்த / யார் (இரு கருத்துகளை இணைக்கும் சொல்)",
  "w5419": "ஏற்கெனவே",
  "w5420": "இன்னும் இல்லை",
  "w5421": "எதிர்காலம் காட்டும் சொல் (எ.கா. 'போவேன்')",
  "w5422": "இல்லை",
  "w5423": "இல்லை",
  "w5424": "ஆம்",
  "w5425": "அல்ல",
  "w5426": "முடியும்; -லாம்",
  "w5427": "முடியாது; கூடாது",
  "w5428": "கட்டாயம் வேண்டும்",
  "w5429": "-க்காக (பொருட்டு)",
  "w5430": "உடன்",
  "w5431": "இருந்து",
  "w5432": "-க்கு",
  "w5433": "-இல்",
  "w5434": "போல; அதே",
  "w5435": "மட்டும்",
  "w5436": "-உம்; கூட",
  "w5437": "மிகவும்",
  "w5438": "அதிகமாக; அளவுக்கு மீறி",
  "w5439": "கொஞ்சம்",
  "w5440": "நிறைய",
  "w5441": "இப்போதுதான்",
  "w5442": "எப்போதும்",
  "w5443": "…போது",
  "w5444": "ஒருவேளை",
  "w5445": "என்றால்",
  "w5446": "பற்றி",
  "w5447": "இருந்தாலும்",
  "w5448": "வரை",
  "w5449": "ஒன்றாக",
  "w5450": "முன்பு",
  "w5451": "முதலில்; சற்று",
  "w5452": "வேண்டாம்",
  "w5453": "தேவையில்லை",
  "w5454": "மகிழ்ச்சியான",
  "w5455": "உற்சாகமான; வேடிக்கையான",
  "w5456": "சோகமான",
  "w5457": "கோபமான",
  "w5458": "பயந்த",
  "w5459": "வெட்கப்படும்",
  "w5460": "களைப்பான",
  "w5461": "வியப்படைந்த; திடுக்கிட்ட",
  "w5462": "பதற்றமான",
  "w5463": "அமைதியான",
  "w5464": "அன்பு; காதல்",
  "w5465": "நேசி",
  "w5466": "உணர்",
  "w5467": "சிரி",
  "w5468": "அழு",
  "w5469": "கவலைப்படு",
  "w5470": "நம்பிக்கை (எதிர்பார்ப்பு)",
  "w5471": "நட்பு",
  "w5472": "பெருமை",
  "w5473": "உணர்ச்சி",
  "w5474": "பொறாமை",
  "w5475": "கஷ்டம்; துன்பம்",
  "w5476": "நம்பிக்கை; தன்னம்பிக்கை",
  "w5477": "பொறுமை",
  "w5478": "நினைத்து ஏங்கு",
  "w5479": "தைரியம்",
  "w5480": "விளையாட்டு",
  "w5481": "கால்பந்து",
  "w5482": "பந்து",
  "w5483": "விளையாடு",
  "w5484": "ஆட்டம்; போட்டி",
  "w5485": "அணி",
  "w5486": "விளையாட்டு வீரர்",
  "w5487": "பயிற்சியாளர்",
  "w5488": "நடுவர்",
  "w5489": "கோல்",
  "w5490": "வெற்றி பெறு",
  "w5491": "நீந்து",
  "w5492": "குதி",
  "w5493": "உதை",
  "w5494": "கைப்பந்து",
  "w5495": "ஓட்டப்பந்தயம்",
  "w5496": "வாகையர் போட்டி; லீக்",
  "w5497": "பதக்கம்",
  "w5498": "மைதானம்",
  "w5499": "விளையாட்டரங்கம்",
  "w5500": "போட்டி",
  "w5501": "பயிற்சி",
  "w5502": "முடிவு; புள்ளிகள்",
  "w5503": "ஃபுட்சால் (உள்ளரங்கக் கால்பந்து)",
  "w5504": "அணித்தலைவர்",
  "w5505": "உடற்பயிற்சி",
  "w5506": "சமநிலையில் முடி",
  "w5507": "கைப்பேசி",
  "w5508": "தொலைபேசி",
  "w5509": "கணினி",
  "w5510": "இணையம்",
  "w5511": "வானொலி",
  "w5512": "தொலைக்காட்சி",
  "w5513": "மின்சாரம்",
  "w5514": "மின்கலம்",
  "w5515": "மின்னேற்றம் செய்",
  "w5516": "மின்னேற்றி (சார்ஜர்)",
  "w5517": "இயக்கு (சுவிட்சைப் போடு)",
  "w5518": "அணை",
  "w5519": "புகைப்படம்",
  "w5520": "கேமரா",
  "w5521": "காணொளி",
  "w5522": "செய்தி",
  "w5523": "மின்னஞ்சல்",
  "w5524": "செயலி",
  "w5525": "அச்சுப்பொறி",
  "w5526": "தொழில்நுட்பம்",
  "w5527": "இயந்திரம்",
  "w5528": "மின்னாக்கி (ஜெனரேட்டர்)",
  "w5529": "சூரிய மின்தகடு",
  "w5530": "டிஜிட்டல்",
  "w5531": "வலையமைப்பு; சிக்னல்",
  "w5532": "கணிப்பான்",
  "w5533": "ஆற்றல்",
  "w5534": "நிகழ்ச்சி; நிரல்",
  "w5535": "கடல்",
  "w5536": "கடற்கரை",
  "w5537": "கடலோரம்",
  "w5538": "அலை",
  "w5539": "Tasi Feto (திமோரின் வடக்கே உள்ள அமைதியான கடல்; நேர்ப்பொருள்: 'பெண் கடல்')",
  "w5540": "Tasi Mane (திமோரின் தெற்கே உள்ள கொந்தளிப்பான கடல்; நேர்ப்பொருள்: 'ஆண் கடல்')",
  "w5541": "மீன்",
  "w5542": "மீன் பிடி",
  "w5543": "மீனவர்",
  "w5544": "மீன்பிடித் தொழில்",
  "w5545": "தோணி",
  "w5546": "மீன்வலை",
  "w5547": "தூண்டில்",
  "w5548": "மீன் பொறி",
  "w5549": "பவளம்",
  "w5550": "கடல் ஆமை",
  "w5551": "திமிங்கலம்",
  "w5552": "ஓங்கில் (டால்பின்)",
  "w5553": "சுறா",
  "w5554": "இறால்",
  "w5555": "நண்டு",
  "w5556": "ஆழ்கடல்",
  "w5557": "கடல் கடந்த நாடு",
  "w5558": "நீர்மூழ்கல்",
  "w5559": "அலையாத்திக் காடு (சதுப்புநிலக் காடு)",
  "w5560": "எனக்குப் புரியவில்லை.",
  "w5561": "எனக்குத் தெரியாது.",
  "w5562": "தயவுசெய்து மெதுவாகப் பேசுங்கள்.",
  "w5563": "தயவுசெய்து மீண்டும் சொல்லுங்கள்.",
  "w5564": "நீங்கள் தேத்துன் மொழி பேசுவீர்களா?",
  "w5565": "நான் கொஞ்சம் தேத்துன் மொழி பேசுவேன்.",
  "w5566": "உங்கள் பெயர் என்ன?",
  "w5567": "என் பெயர் மரியா.",
  "w5568": "நீங்கள் எங்கிருந்து வருகிறீர்கள்?",
  "w5569": "நான் பௌகாவிலிருந்து வருகிறேன்.",
  "w5570": "நீங்கள் எங்கே வசிக்கிறீர்கள்?",
  "w5571": "நான் டிலியில் வசிக்கிறேன்.",
  "w5572": "உங்களுக்கு என்ன வயது?",
  "w5573": "இது என்ன?",
  "w5574": "இதைத் தேத்துன் மொழியில் என்னவென்று சொல்வார்கள்?",
  "w5575": "இந்தச் சொல்லின் பொருள் என்ன?",
  "w5576": "இது என்ன விலை?",
  "w5577": "மிகவும் விலை அதிகம்!",
  "w5578": "விலையைக் கொஞ்சம் குறைக்க முடியுமா?",
  "w5579": "நான் இதை வாங்க விரும்புகிறேன்.",
  "w5580": "கழிப்பறை எங்கே இருக்கிறது?",
  "w5581": "மருத்துவமனை எங்கே இருக்கிறது?",
  "w5582": "நான் வழி தவறிவிட்டேன்.",
  "w5583": "நேராகச் செல்லுங்கள்.",
  "w5584": "இடது பக்கம் திரும்புங்கள்.",
  "w5585": "வலது பக்கம் திரும்புங்கள்.",
  "w5586": "வாருங்கள், போகலாம்!",
  "w5587": "கொஞ்சம் காத்திருங்கள்!",
  "w5588": "காப்பாற்றுங்கள்!",
  "w5589": "கவனமாக இருங்கள்!",
  "w5590": "காவல்துறையை அழையுங்கள்!",
  "w5591": "எனக்கு உதவ முடியுமா?",
  "w5592": "நான் உள்ளே வரலாமா?",
  "w5593": "பிரச்சினை இல்லை.",
  "w5594": "மிகவும் நல்லது!",
  "w5595": "நான் ஒப்புக்கொள்கிறேன்.",
  "w5596": "நான் உன்னை நேசிக்கிறேன்.",
  "w5597": "எனக்கு ஒரு கேள்வி இருக்கிறது.",
  "w5598": "கவனமாகக் கேளுங்கள்!",
  "w5599": "என்ன நடந்தது?",
  "w5600": "நாம் அனைவரும் சமம்."
 }
}
